# docker/Dockerfile.thor は ramen/ と conformance 一式だけを COPY するが、build context には repo が
# 丸ごと送られる。ここに書いたものは context に入らない (= image にも入らない)。
#
# 注意: build context は **git ではなく working directory** なので、.gitignore で
# 無視されているだけのファイルも放っておくと image に入る。両方で弾く。

# git 履歴を image に持ち込まない (提出物なので不要。commit のたびに層が変わるのも避ける)
.git
.gitignore
.dockerignore

# ローカルで生成されたバイトコード。ホスト (macOS) の Python で作られたものが
# 混ざるだけで益が無い。
__pycache__/
*.py[cod]
.pytest_cache/

# 資格情報・ローカル環境。**公開 image に焼かない**。
.env
.env.*
.venv/
venv/
env/

# エディタ / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# pixi の環境の実体と SDK のソース。image の中で pixi install / git clone して作るので、
# 手元で作ったものを build context に持ち込まない (巨大で、しかも手元の platform 用)。
.pixi/
**/.pixi/
ramen/third_party/
